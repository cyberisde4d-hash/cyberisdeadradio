  $("themePanel").innerHTML = `<div class="editor wide-editor"><h2>Visual / Theme</h2><p class="help">Controle visual global sem mexer no código. Para deixar o fundo mais visível, aumente Opacidade/Brilho e reduza Overlay escuro.</p><fieldset><legend>Background dinâmico — Desktop</legend><div class="grid3">${input("theme_bgOpacity","Opacidade do background","number",'step="0.01" min="0" max="1" placeholder="0.62"')}${input("theme_bgBrightness","Brilho do background","number",'step="0.01" min="0" max="2" placeholder="0.78"')}${input("theme_bgContrast","Contraste","number",'step="0.01" min="0" max="2" placeholder="1.08"')}</div><div class="grid3">${input("theme_bgGrayscale","Preto e branco do fundo","number",'step="0.01" min="0" max="1" placeholder="1"')}${input("theme_bgBlur","Blur em px","number",'step="1" min="0" placeholder="0"')}${input("theme_noiseOpacity","Opacidade do noise","number",'step="0.01" min="0" max="1" placeholder="0.045"')}</div>${input("theme_overlay","Overlay CSS do fundo","textarea",'placeholder="linear-gradient(to right,rgba(0,0,0,.68),rgba(0,0,0,.28),rgba(0,0,0,.66)),linear-gradient(to top,rgba(0,0,0,.66),transparent 55%)"')}<p class="note">Dica: overlay mais transparente = imagem do fundo mais aparente.</p></fieldset><fieldset><legend>Background — Mobile opcional</legend><div class="grid3">${input("theme_mobileBgOpacity","Opacidade mobile","number",'step="0.01" min="0" max="1" placeholder="0.54"')}${input("theme_mobileBgBrightness","Brilho mobile","number",'step="0.01" min="0" max="2" placeholder="0.72"')}${input("theme_mobileBgBlur","Blur mobile px","number",'step="1" min="0" placeholder="0"')}</div></fieldset><fieldset><legend>Cores principais</legend><div class="grid2">${input("theme_textColor","Cor do texto")}${input("theme_mutedColor","Cor secundária")}</div><div class="grid2">${input("theme_lineColor","Cor das linhas")}${input("theme_buttonColor","Cor dos botões")}</div><div class="grid2">${input("theme_buttonTextColor","Texto dos botões