# Copie para backend/.env e preencha — NUNCA commite o .env com valores.
# Tumblr: OAuth 1.0a de USUÁRIO. POST /v2/blog/{blog}/post exige as 4.
# Só consumer key/secret (app) sem token/token_secret (usuário) sempre dá 401.
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_TOKEN=
TUMBLR_TOKEN_SECRET=
# Callback EXATO registrado no app (tumblr.com/oauth/apps). Obrigatório no request.
TUMBLR_CALLBACK_URL=
# Substack (áudio)
SUBSTACK_COOKIE=
SUBSTACK_LLI=
SUBSTACK_POST_ID=
SUBSTACK_PUBLICATION=
PORT=3000
